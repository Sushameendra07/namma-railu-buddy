<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_karnataka" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#BF000000" />

    <ScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/karnataka_logo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@+id/timeCard"
                    app:layout_constraintStart_toEndOf="@+id/imgLogo"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pacifico"
                        android:text="Namma"
                        android:textColor="#FFD54F"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="Railu Buddy"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Journey, Our Pride"
                        android:textColor="#CCFFFFFF"
                        android:textSize="10sp"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/timeCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#55000000"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#33FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/txtLiveTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txtLiveDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#BBBBBB"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#D1141414"
                app:cardCornerRadius="24dp"
                app:strokeColor="#44FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/train_number_hint"
                        android:textColorHint="#99FFFFFF"
                        app:hintTextColor="#FFD54F"
                        app:startIconDrawable="@android:drawable/ic_menu_directions"
                        app:startIconTint="#FFD54F">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/trainNumberEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="#FFFFFF" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/journey_date_hint"
                        android:textColorHint="#99FFFFFF"
                        app:hintTextColor="#FFD54F"
                        app:startIconDrawable="@android:drawable/ic_menu_my_calendar"
                        app:startIconTint="#FFD54F">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/journeyDateEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="#FFFFFF" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <ProgressBar
                        android:id="@+id/progressLoading"
                        style="?android:attr/progressBarStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnFetch"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="@string/track_live_train"
                        android:textColor="#000000"
                        android:backgroundTint="#FFD54F"
                        app:cornerRadius="16dp" />

                    <TextView
                        android:id="@+id/txtDataState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/no_live_data_showing_last_update"
                        android:textColor="#FFD54F"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:weightSum="4">
                <include layout="@layout/view_quick_action_item" android:id="@+id/actionLive" />
                <include layout="@layout/view_quick_action_item" android:id="@+id/actionCoach" />
                <include layout="@layout/view_quick_action_item" android:id="@+id/actionPlatform" />
                <include layout="@layout/view_quick_action_item" android:id="@+id/actionAlerts" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/resultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                app:cardBackgroundColor="#E3121212"
                app:cardCornerRadius="24dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/txtTrainName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp" />
                        <TextView
                            android:id="@+id/txtStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/bg_status_badge"
                            android:backgroundTint="#FFD600"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="On Time"
                            android:textColor="#000000"
                            android:textSize="13sp"
                            android:fontFamily="@font/montserrat_bold"/>
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/txtSource" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Source" android:textColor="#CCCCCC" android:textSize="12sp"/>
                        <TextView android:id="@+id/txtDestination" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Destination" android:textColor="#CCCCCC" android:textSize="12sp" android:gravity="end"/>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressTrain"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:progress="60"
                        android:progressTint="#00FF88" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/txtPlatform" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Platform: 1" android:textColor="#FFFFFF" android:textSize="21sp" android:fontFamily="@font/montserrat_bold"/>
                        <TextView android:id="@+id/txtEta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ETA: 12:45 PM" android:textColor="#FFFFFF" android:textSize="15sp" android:gravity="end" android:fontFamily="@font/montserrat_bold"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtLastUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Last Updated: Just Now"
                        android:textColor="#88FFFFFF"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="#22FFFFFF">
                        <TextView
                            android:id="@+id/txtAccuracy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Accuracy Score: 96%"
                            android:textColor="#BB86FC"
                            android:textSize="11sp"
                            android:fontFamily="@font/montserrat_bold" />
                        <TextView
                            android:id="@+id/txtCrowdStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Crowd Status: Low"
                            android:textColor="#00FF88"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Coach Sequence (Tap for details)"
                        android:textColor="#FFD54F"
                        android:textSize="12sp"
                        android:fontFamily="@font/montserrat_bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="80dp"
                        android:layout_marginTop="12dp"
                        android:scrollbars="none">
                        <LinearLayout
                            android:id="@+id/coachContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/txtCurrentStation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#00FF88"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtNextStation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#BB86FC"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnRetry"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/retry"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnTrack"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:text="Track Live Location"
                        android:textSize="12sp"
                        app:cornerRadius="12dp" />

                    <TextView
                        android:id="@+id/txtDestinationStation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#22FFFFFF"
                        android:padding="12dp"
                        android:text="@string/select_destination_station"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/trigger_radius_hint"
                        app:boxBackgroundMode="outline">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTriggerRadius"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:text="@string/radius_prefill"
                            android:textColor="#FFFFFF" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnSetAlarm"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/set_destination_alarm"
                        android:textSize="12sp"
                        app:cornerRadius="12dp" />

                    <TextView
                        android:id="@+id/txtAlarmStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/alarm_status_disarmed"
                        android:textColor="#FFD54F"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>