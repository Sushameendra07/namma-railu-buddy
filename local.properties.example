## Copy to local.properties and fill in your keys
## ONE FILE — see everything here

sdk.dir=C\:\\Users\\YOUR_USER\\AppData\\Local\\Android\\Sdk

# IRCTC RapidAPI (REQUIRED) — https://rapidapi.com/IRCTCAPI/api/irctc1
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=irctc1.p.rapidapi.com

# Google Maps — https://console.cloud.google.com/
MAPS_API_KEY=your_maps_key_here

# Firebase — use app/google-services.json (not this file)
